<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower (API 31+ uses data_extraction_rules.xml).
   No patient data is ever persisted, so nothing sensitive can be backed up. Only the
   preferences file holding the intended-use acknowledgement and the language choice is
   kept, so a restored install doesn't ask the user to start over. Everything else
   (databases, files, other prefs) is left out by omission.
-->
<full-backup-content>
    <include domain="sharedpref" path="clitical_preferences.xml" />
</full-backup-content>
