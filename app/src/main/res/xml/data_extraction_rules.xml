<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and higher.
   No patient data is ever persisted, so nothing sensitive can be backed up or transferred.
   Only the preferences file holding the intended-use acknowledgement and the language
   choice is kept; everything else is left out by omission of an include.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="clitical_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="clitical_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
